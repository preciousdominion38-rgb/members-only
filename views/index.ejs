<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Members Only</title>
<link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<nav>
  <a href="/">Members Only</a>
  <div>
    <% if(user) { %>
      <a href="/members" class="btn">Members</a>
      <a href="/logout" class="btn">Logout</a>
    <% } else { %>
      <a href="/login" class="btn">Login</a>
      <a href="/register" class="btn">Register</a>
    <% } %>
  </div>
</nav>
<main>
  <div class="card">
    <h1 style="font-size:2.5rem; font-weight:bold; margin-bottom:1rem;">Welcome to Members Only</h1>
    <p style="margin-bottom:2rem;">Sign up or log in to access exclusive content.</p>
    <% if(!user) { %>
      <a href="/register" class="btn">Get Started</a>
      <a href="/login" class="btn">Login</a>
    <% } else { %>
      <a href="/members" class="btn">Go to Members Area</a>
    <% } %>
    <br><br>
    <button id="modeToggle" class="btn">Toggle Dark Mode</button>
  </div>
</main>
<script>
const toggle = document.getElementById('modeToggle');
toggle.addEventListener('click', () => {
  document.body.classList.toggle('dark');
});
</script>
</body>
</html>
