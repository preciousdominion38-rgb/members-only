<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Members Area</title>
<link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<nav>
  <a href="/">Members Only</a>
  <div>
    <a href="/logout" class="btn">Logout</a>
  </div>
</nav>
<main>
  <div class="card">
    <h2 style="font-size:2rem; margin-bottom:1rem;">Welcome, <%= user.username %>!</h2>
    <img src="<%= user.avatar %>" alt="Avatar" width="100" height="100">

    <form action="/members/post" method="POST" style="margin:1rem 0;">
      <textarea name="content" placeholder="Share something..." required></textarea>
      <button type="submit" class="btn">Post</button>
    </form>

    <h3>Recent Posts</h3>
    <% if(user.posts.length === 0) { %>
      <p>No posts yet. Be the first!</p>
    <% } %>
    <% user.posts.forEach(post => { %>
      <div class="post">
        <p><%= post.content %></p>
        <small><%= new Date(post.createdAt).toLocaleString() %></small>
      </div>
    <% }) %>

    <br>
    <button id="modeToggle" class="btn">Toggle Dark Mode</button>
  </div>
</main>
<script>
const toggle = document.getElementById('modeToggle');
toggle.addEventListener('click', () => {
  document.body.classList.toggle('dark');
});
</script>
</body>
</html>
